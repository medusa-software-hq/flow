CREATE TABLE session_new (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  task_graph_proto_bytes BLOB NOT NULL,
  title TEXT NOT NULL DEFAULT '',
  state TEXT NOT NULL DEFAULT 'draft'
);

INSERT INTO session_new(id, task_graph_proto_bytes, title, state)
SELECT CAST(id AS INTEGER), task_graph_proto_bytes, title, 'draft'
FROM session;

DROP TABLE session;

ALTER TABLE session_new RENAME TO session;

CREATE TABLE session_task_execution_state_new (
  session_id INTEGER NOT NULL,
  task_id TEXT NOT NULL,
  progress REAL NOT NULL DEFAULT 0,
  result_int INTEGER,
  PRIMARY KEY (session_id, task_id)
);

INSERT INTO session_task_execution_state_new(session_id, task_id, progress, result_int)
SELECT CAST(session_id AS INTEGER), task_id, progress, result_int
FROM session_task_execution_state;

DROP TABLE session_task_execution_state;

ALTER TABLE session_task_execution_state_new RENAME TO session_task_execution_state;
