CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  task_graph_proto_bytes BLOB NOT NULL,
  title TEXT NOT NULL DEFAULT ''
);

insertSession:
INSERT INTO session(id, title, task_graph_proto_bytes)
VALUES (?, ?, ?);

selectSessionById:
SELECT * FROM session
WHERE id = ?;

updateSessionTaskGraph:
UPDATE session
SET title = ?, task_graph_proto_bytes = ?
WHERE id = ?;

selectAllSessions:
SELECT * FROM session
ORDER BY id;
