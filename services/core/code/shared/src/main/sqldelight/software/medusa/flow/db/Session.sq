CREATE TABLE session (
  id TEXT NOT NULL PRIMARY KEY,
  task_graph_proto_bytes BLOB NOT NULL
);

insertSession:
INSERT INTO session(id, task_graph_proto_bytes)
VALUES (?, ?);

selectSessionById:
SELECT * FROM session
WHERE id = ?;

updateSessionTaskGraph:
UPDATE session
SET task_graph_proto_bytes = ?
WHERE id = ?;

selectAllSessions:
SELECT * FROM session
ORDER BY id;
