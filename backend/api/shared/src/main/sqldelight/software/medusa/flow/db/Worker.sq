-- Schema for SQLDelight compile-time query verification (Postgres dialect).
-- The runtime schema is owned by Flyway; keep these table definitions identical
-- to the net effect of the migrations (V6 created the table, V7 dropped the
-- `supported_engines` column when workers became uniform).
CREATE TABLE workers (
  worker_id         TEXT NOT NULL PRIMARY KEY,
  worker_version    TEXT NOT NULL DEFAULT '',
  image_digest      TEXT NOT NULL DEFAULT '',
  first_seen_at     TIMESTAMPTZ NOT NULL,
  last_seen_at      TIMESTAMPTZ NOT NULL
);

-- Register (or refresh) a worker. On first sight the row is inserted with
-- first_seen_at = last_seen_at = :now; on every later registration only the
-- mutable columns and last_seen_at move, so first_seen_at is preserved.
upsertWorker:
INSERT INTO workers (worker_id, worker_version, image_digest, first_seen_at, last_seen_at)
VALUES (?, ?, ?, :now, :now)
ON CONFLICT (worker_id) DO UPDATE SET
  worker_version    = EXCLUDED.worker_version,
  image_digest      = EXCLUDED.image_digest,
  last_seen_at      = EXCLUDED.last_seen_at;

-- Freshest first, so the liveness preflight can take the head as "the worker".
listWorkers:
SELECT * FROM workers ORDER BY last_seen_at DESC;
