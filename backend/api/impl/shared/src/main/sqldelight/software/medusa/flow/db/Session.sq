-- Schema for SQLDelight compile-time query verification (Postgres dialect).
-- The runtime schema is owned by Flyway; keep these table definitions identical
-- to src/main/resources/db/migration/V2__create_sessions.sql.
CREATE TABLE sessions (
  id                TEXT NOT NULL PRIMARY KEY,
  -- M6: groups the sessions claimed & run together as one unit of work (V10).
  -- A manual session is its own 1-session job; a reconciled issue's Claude +
  -- built-in sessions share one job_id.
  job_id            TEXT NOT NULL DEFAULT '',
  repo_full_name    TEXT NOT NULL,
  task_markdown     TEXT NOT NULL,
  state             TEXT NOT NULL,
  created_at        TIMESTAMPTZ NOT NULL,
  created_by        TEXT NOT NULL,
  claimed_at        TIMESTAMPTZ,
  last_heartbeat_at TIMESTAMPTZ,
  pr_url            TEXT,
  failure_summary   TEXT,
  -- M2: issue linkage (V3). NULL for manual sessions. Populated by later stories.
  issue_pipeline_id TEXT,
  issue_number      INTEGER,
  issue_url         TEXT,
  -- M4: requested engine (V4). 'UNSPECIFIED' = the claiming worker's default.
  engine            TEXT NOT NULL DEFAULT 'UNSPECIFIED',
  -- M4: terminal run cost in USD (V5). NULL until the RUN_COST event lands.
  total_cost_usd    DOUBLE PRECISION,
  -- Bounded retry (V12): how many times this session has been requeued after a
  -- worker death. 0 = never requeued.
  attempt_count     INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE session_events (
  session_id TEXT NOT NULL REFERENCES sessions (id),
  seq        INTEGER NOT NULL,
  created_at TIMESTAMPTZ NOT NULL,
  kind       TEXT NOT NULL,
  message    TEXT NOT NULL,
  PRIMARY KEY (session_id, seq)
);

insertSession:
INSERT INTO sessions (id, job_id, repo_full_name, task_markdown, state, created_at, created_by, engine)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectSessionById:
SELECT * FROM sessions WHERE id = ?;

listSessions:
SELECT * FROM sessions ORDER BY created_at DESC LIMIT ?;

-- Atomically claim the oldest PENDING session (FOR UPDATE SKIP LOCKED so two
-- workers never claim the same one); returns the claimed row, or nothing when
-- the queue is empty.
claimNextSession:
UPDATE sessions
SET state = 'RUNNING', claimed_at = :now, last_heartbeat_at = :now
WHERE id = (
  SELECT id FROM sessions
  WHERE state = 'PENDING'
  ORDER BY created_at
  LIMIT 1
  FOR UPDATE SKIP LOCKED
)
RETURNING *;

-- Atomically claim the oldest PENDING *job* — every PENDING session sharing the
-- oldest pending session's job_id — so one worker owns the whole unit of work
-- (both engines of a reconciled issue) and runs them in parallel. SKIP LOCKED on
-- the picked row keeps two workers from racing onto the same job; returns every
-- session it transitioned, or nothing when the queue is empty.
claimNextJob:
UPDATE sessions
SET state = 'RUNNING', claimed_at = :now, last_heartbeat_at = :now
WHERE state = 'PENDING' AND job_id = (
  SELECT job_id FROM sessions
  WHERE state = 'PENDING'
  ORDER BY created_at
  LIMIT 1
  FOR UPDATE SKIP LOCKED
)
RETURNING *;

selectMaxEventSeq:
SELECT COALESCE(MAX(seq), 0) FROM session_events WHERE session_id = ?;

insertEvent:
INSERT INTO session_events (session_id, seq, created_at, kind, message)
VALUES (?, ?, ?, ?, ?);

-- Stamp the terminal run cost onto a RUNNING session (M4). Guarded like the other
-- worker mutations; returns the id when it applied.
stampCostIfRunning:
UPDATE sessions
SET total_cost_usd = :cost, last_heartbeat_at = :now
WHERE id = ? AND state = 'RUNNING'
RETURNING id;

selectEventsAfterSeq:
SELECT * FROM session_events
WHERE session_id = ? AND seq > ?
ORDER BY seq;

-- Guarded worker mutations: each only touches a RUNNING session and returns the
-- id when it applied, so the caller can distinguish "applied" from
-- "precondition failed" (absent or not RUNNING) by presence of a row.
touchHeartbeatIfRunning:
UPDATE sessions SET last_heartbeat_at = :now
WHERE id = ? AND state = 'RUNNING'
RETURNING id;

completeIfRunning:
UPDATE sessions
SET state = 'COMPLETED', pr_url = ?, last_heartbeat_at = :now
WHERE id = ? AND state = 'RUNNING'
RETURNING id;

-- Normally transitions a RUNNING session straight to FAILED, same as before.
-- When :workerDeath is true (the worker itself died — a crash, node failure, or
-- a drain that exceeded its deadline — rather than a genuine engine/task
-- failure) and the session hasn't exhausted its bounded retry budget
-- (attempt_count < :maxAttempts), it is requeued to PENDING instead: claim and
-- heartbeat cleared, attempt_count bumped, failure_summary left untouched, so
-- the next claim gives it a fresh attempt rather than abandoning the work.
-- Returns the row (inspect `state` to tell which branch was taken) when the
-- guard applied.
requeueOrFailIfRunning:
UPDATE sessions
SET
  state = CASE
    WHEN :workerDeath::BOOLEAN AND attempt_count < :maxAttempts THEN 'PENDING'
    ELSE 'FAILED'
  END,
  failure_summary = CASE
    WHEN :workerDeath::BOOLEAN AND attempt_count < :maxAttempts THEN failure_summary
    ELSE :failureSummary
  END,
  attempt_count = CASE
    WHEN :workerDeath::BOOLEAN AND attempt_count < :maxAttempts THEN attempt_count + 1
    ELSE attempt_count
  END,
  claimed_at = CASE
    WHEN :workerDeath::BOOLEAN AND attempt_count < :maxAttempts THEN NULL::TIMESTAMPTZ
    ELSE claimed_at
  END,
  last_heartbeat_at = CASE
    WHEN :workerDeath::BOOLEAN AND attempt_count < :maxAttempts THEN NULL::TIMESTAMPTZ
    ELSE :now
  END
WHERE id = :id AND state = 'RUNNING'
RETURNING *;

-- Human "stop": a RUNNING session -> ABORTED. Returns the id when it applied.
abortIfRunning:
UPDATE sessions SET state = 'ABORTED', last_heartbeat_at = :now
WHERE id = ? AND state = 'RUNNING'
RETURNING id;

-- The current state of a session (or absent), to tell an ABORTED session apart
-- from a genuinely-gone one after a guarded write finds it isn't RUNNING.
selectSessionState:
SELECT state FROM sessions WHERE id = ?;

-- Lazy expiry: a RUNNING session whose heartbeat is older than the cutoff is a
-- worker death by definition (the worker went silent with no chance to signal
-- anything). Bounded-retry requeue applies here too: back to PENDING (bumping
-- attempt_count, clearing claim/heartbeat) while under the retry budget
-- (attempt_count < :maxAttempts), else FAILED ("worker lost"). Returns the ids
-- it touched (both branches).
expireStaleSessions:
UPDATE sessions
SET
  state = CASE WHEN attempt_count < :maxAttempts THEN 'PENDING' ELSE 'FAILED' END,
  failure_summary = CASE
    WHEN attempt_count < :maxAttempts THEN failure_summary
    ELSE :failureSummary
  END,
  attempt_count = CASE
    WHEN attempt_count < :maxAttempts THEN attempt_count + 1
    ELSE attempt_count
  END,
  claimed_at = CASE
    WHEN attempt_count < :maxAttempts THEN NULL::TIMESTAMPTZ
    ELSE claimed_at
  END,
  last_heartbeat_at = CASE
    WHEN attempt_count < :maxAttempts THEN NULL::TIMESTAMPTZ
    ELSE last_heartbeat_at
  END
WHERE state = 'RUNNING' AND last_heartbeat_at < :cutoff
RETURNING id;
